# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Server-side API key for the AstaSecure AI Operations Agent (@google/genai).
# Configured via Secrets panel in AI Studio. Never expose to the browser.
GEMINI_API_KEY=""

# AI_MODEL: Server-side Gemini model alias for AI Operations Agent.
AI_MODEL="gemini-4-hydrogen"

# SCAN_SIGNING_SECRET: Secret used to HMAC-SHA256 sign server-computed scan results and ownership proofs.
SCAN_SIGNING_SECRET="CHANGE_ME_IN_PRODUCTION"

# Optional SMTP configuration for email notifications, contact alerts, and service job updates
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
CONTACT_RECIPIENT_EMAIL=""

# Optional WhatsApp Business Cloud API configuration
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""

# Optional PostgreSQL connection string for future database migration
DATABASE_URL=""
